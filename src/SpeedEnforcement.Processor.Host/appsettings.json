{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000",
        "Protocols": "Http1AndHttp2"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:5001",
        "Protocols": "Http2"
      }
    }
  },
  "Ingestion": {
    "PartitionCount": 4,
    "ChannelCapacity": 10000,
    "RejectionAbortConsecutive": 10,
    "RejectionAbortRatio": 0.05,
    "RejectionWindowSize": 1000
  },
  "Analytics": {
    "CameraCount": 10,
    "LeaderboardCapacity": 10,
    "GlobalLeaderboardGate": 3
  },
  "Telemetry": {
    "ConsoleMetricsExporter": false
  },
  "AllowedHosts": "*"
}
